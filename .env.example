# Core app
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secrets
AUTH_SECRET=replace-with-a-32-character-or-longer-secret
SESSION_TTL_SECONDS=604800

# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wurdi

# Blockchain/provider configuration for future wallet and portfolio ingestion
BLOCKCHAIN_PROVIDER=rpc
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
INDEXER_URL=

# Public Monad Testnet profit-lock vault contract address
NEXT_PUBLIC_VAULT_ADDRESS=0x3f607f7CD4AA3aC6992a0E5408515574BCb03Bc8

# Optional app config
WALLET_PROVIDER=none
